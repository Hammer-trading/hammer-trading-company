  projectMedia ProjectMedia[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([kind, createdAt])
  @@index([uploadedById])
}

model PackageCategory {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  image       String?
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  packages    ProductPackage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, sortOrder])
}

model ProductPackage {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  sku                   String           @unique
  categoryId            String?
  category              PackageCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverImage            String?
  gallery               Json             @default("[]")
  shortDescription      String           @default("")
  description           String
  roomType              String           @default("Complete room")
  tier                  String           @default("STANDARD")
  coverageSummary       String?
  customizationNotes    String?
  deliveryInformation   String?
  installationIncluded  Boolean          @default(false)
  originalPrice         Decimal          @default(0) @db.Decimal(12, 2)
  fixedDiscount         Decimal          @default(0) @db.Decimal(12, 2)
  percentageDiscount    Int              @default(0)
  finalPrice            Decimal          @default(0) @db.Decimal(12, 2)
  badge                 String?
  installationServiceId String?
  installationService   HomeService?     @relation(fields: [installationServiceId], references: [id], onDelete: SetNull)
  legacyRoomPackageId   String?          @unique
  legacyRoomPackage     RoomPackage?     @relation(fields: [legacyRoomPackageId], references: [id], onDelete: SetNull)
  legacyItems           Json?
  migrationStatus       String?
  isFeatured            Boolean          @default(false)
  showOnHomepage        Boolean          @default(false)
  isActive              Boolean          @default(true)
  status                ContentStatus    @default(DRAFT)
  sortOrder             Int              @default(0)
  seoTitle              String?
  seoDescription        String?
  imageAlt              String?
  items                 PackageItem[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  serviceBookings       ServiceBooking[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([categoryId])
  @@index([status, isActive, sortOrder])
  @@index([showOnHomepage, isFeatured])
}

model PackageItem {
  id        String          @id @default(cuid())
  packageId String
  package   ProductPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  sortOrder Int             @default(0)

  @@unique([packageId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model ServiceCategory {
  id          String        @id @default(cuid())
