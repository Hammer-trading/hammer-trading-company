  image       String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  services    HomeService[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, sortOrder])
}

model HomeService {
  id                      String           @id @default(cuid())
  name                    String
  slug                    String           @unique
  categoryId              String?
  category                ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shortDescription        String           @default("")
  description             String
  serviceMode             String           @default("PRODUCT_INSTALLATION")
  siteVisitRequired       Boolean          @default(true)
  siteVisitFee            Decimal          @default(0) @db.Decimal(12, 2)
  laborPricingNote        String?
  startingPrice           Decimal?         @db.Decimal(12, 2)
  fixedPrice              Decimal?         @db.Decimal(12, 2)
  requestQuoteEnabled     Boolean          @default(true)
  bookingEnabled          Boolean          @default(true)
  whatsappEnabled         Boolean          @default(true)
  coverImage              String?
  gallery                 Json             @default("[]")
  beforeAfter             Json             @default("[]")
  videos                  Json             @default("[]")
  estimatedCompletionTime String?
  availableDays           String[]         @default([])
  availableTimeSlots      String[]         @default([])
  cities                  String[]         @default([])
  areas                   String[]         @default([])
  warrantyInformation     String?
  includedWork            String[]         @default([])
  excludedWork            String[]         @default([])
  requiredMaterials       String[]         @default([])
  isFeatured              Boolean          @default(false)
  showOnHomepage          Boolean          @default(false)
  isActive                Boolean          @default(true)
  status                  ContentStatus    @default(DRAFT)
  sortOrder               Int              @default(0)
  seoTitle                String?
  seoDescription          String?
  imageAlt                String?
  products                ServiceProduct[]
  packages                ProductPackage[]
  bookings                ServiceBooking[]
  projects                Project[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([categoryId])
  @@index([status, isActive, sortOrder])
  @@index([showOnHomepage, isFeatured])
}

model ServiceProduct {
  id        String      @id @default(cuid())
  serviceId String
  service   HomeService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0)

  @@unique([serviceId, productId])
  @@index([productId])
}

model ServiceBooking {
  id                         String               @id @default(cuid())
  requestNumber              String               @unique
  serviceId                  String
  service                    HomeService          @relation(fields: [serviceId], references: [id])
  packageId                  String?
  package                    ProductPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageSnapshot            Json?
  userId                     String?
  user                       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName               String
  phone                      String
  email                      String?
  address                    String
  city                       String
  area                       String?
  preferredDate              DateTime?
  preferredTime              String?
  projectDetails             String?
  attachments                Json                 @default("[]")
  customerNote               String?
  internalNote               String?
  quotationAmount            Decimal?             @db.Decimal(12, 2)
  materialSubtotal           Decimal              @default(0) @db.Decimal(12, 2)
  serviceCharge              Decimal              @default(0) @db.Decimal(12, 2)
  quotedTotal                Decimal?             @db.Decimal(12, 2)
  convertedOrderId           String?              @unique
  convertedOrder             Order?               @relation("ServiceBookingConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  legacyRoomServiceRequestId String?              @unique
  legacyRoomServiceRequest   RoomServiceRequest?  @relation(fields: [legacyRoomServiceRequestId], references: [id], onDelete: SetNull)
  items                      ServiceBookingItem[]
  status                     ServiceBookingStatus @default(NEW)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([serviceId, status])
  @@index([userId, createdAt])
  @@index([city, status])
  @@index([phone])
  @@index([packageId])
  @@index([convertedOrderId])
}

model ServiceBookingItem {
  id             String          @id @default(cuid())
  bookingId      String
  booking        ServiceBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name           String
  sku            String
  variantTitle   String?
  variantOptions Json?
  quantity       Int             @default(1)
  unitPrice      Decimal         @default(0) @db.Decimal(12, 2)
  costPrice      Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([bookingId, sortOrder])
  @@index([productId])
  @@index([variantId])
}

model ProjectCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id                     String           @id @default(cuid())
  title                  String
  slug                   String           @unique
  categoryId             String?
  category               ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serviceId              String?
  service                HomeService?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerOrCompany      String?
  location               String?
  shortDescription       String           @default("")
  description            String
  progressPercent        Int              @default(0)
  isCustomerNamePublic   Boolean          @default(false)
  testimonial            String?
  startDate              DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  projectStatus          ProjectStatus    @default(UPCOMING)
  status                 ContentStatus    @default(DRAFT)
  isFeatured             Boolean          @default(false)
  showOnHomepage         Boolean          @default(false)
  coverImage             String?
  videos                 Json             @default("[]")
  seoTitle               String?
  seoDescription         String?
  imageAlt               String?
  sortOrder              Int              @default(0)
  products               ProjectProduct[]
  media                  ProjectMedia[]
  updates                ProjectUpdate[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([categoryId, projectStatus])
  @@index([serviceId])
  @@index([status, showOnHomepage, sortOrder])
}

model ProjectUpdate {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  progressPercent Int?
  milestone       String?
  media           Json     @default("[]")
  isPublic        Boolean  @default(true)
  occurredAt      DateTime @default(now())
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId, isPublic, occurredAt])
  @@index([projectId, sortOrder])
}

model ProjectProduct {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  note      String?
  sortOrder Int             @default(0)

  @@unique([projectId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model ProjectMedia {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  type         String      @default("GALLERY")
  url          String
  altText      String?
  caption      String?
  posterUrl    String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([projectId, type, sortOrder])
  @@index([mediaAssetId])
}

