{
  "name": "hammer-trading-company",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:setup": "node scripts/prisma-with-next-env.mjs generate && node scripts/prisma-with-next-env.mjs migrate deploy && node scripts/prisma-with-next-env.mjs db seed",
    "db:repair-images": "node scripts/repair-store-images.mjs",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "node scripts/prisma-with-next-env.mjs generate",
    "prisma:migrate": "node scripts/prisma-with-next-env.mjs migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-with-next-env.mjs migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "migrate:legacy-services": "node scripts/migrate-room-services-to-platform.mjs",
    "catalog:seed": "tsx prisma/catalog-seed.ts",
    "admin:configure": "node scripts/configure-primary-admin.mjs",
    "admin:reset-password": "node scripts/reset-primary-admin-password.mjs",
    "test:smoke": "node scripts/smoke-local.mjs",
    "test:admin-auth": "node scripts/test-admin-auth.mjs",
    "test:admin-platform": "node scripts/test-admin-platform.mjs",
    "test:service-platform": "node scripts/test-service-platform-crud.mjs",
    "test:content-platform": "node scripts/test-content-platform-crud.mjs",
    "test:chat-isolation": "node scripts/test-chat-isolation.mjs",
    "test:chat-actions": "node scripts/test-chat-message-actions.mjs",
    "test:chat-voice": "node scripts/test-chat-voice-upload.mjs",
    "test:order-stock": "tsx scripts/test-order-stock.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jose": "^5.9.6",
    "lenis": "^1.3.25",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next": "15.5.21",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.6.0",
    "three": "^0.183.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.183.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.0"
  }
}
